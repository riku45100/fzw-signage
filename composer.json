{
    "name": "riku45100/fzw-signage",
    "description": "FZW Signage - digital signage for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1- --ignore=*/vendor/* .",
        "lint:wordpress": "phpcs --standard=WordPress --ignore=*/vendor/* ."
    }
}
